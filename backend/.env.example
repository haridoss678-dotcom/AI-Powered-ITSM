# ==============================================================================
# Sorim.AI — Backend Configuration Template (backend/.env.example)
# Copy to backend/.env when configuring the local FastAPI development server.
# NEVER commit real credentials or database URIs.
# ==============================================================================

# Application & Logging
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas Cloud Database (Cluster0)
# Replace placeholders with real credentials from MongoDB Atlas Database Access.
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB_NAME=itsm_helpdesk
MONGODB_DATABASE=itsm_helpdesk
MONGODB_TIMEOUT_MS=10000
 
# ServiceNow Adapter Mode (v1: mock only)
SERVICENOW_MODE=mock

# AI / Model Configurations (Introduced in Phase 3 & 4)
CONFIDENCE_THRESHOLD=0.60
LLM_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
LLM_DEVICE=cpu
LLM_ALLOW_DOWNLOAD=true
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./.chroma
KNOWLEDGE_BASE_DIR=../knowledge_base
RETRIEVAL_TOP_K=4
